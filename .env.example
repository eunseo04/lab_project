# Copy to .env and adjust. .env is git-ignored.
# --- LLM: local Qwen2.5-0.5B-Instruct (strategy generation, llm_improve) ---
# No API key needed; weights download from Hugging Face on first use.
QWEN_MODEL=Qwen/Qwen2.5-0.5B-Instruct
QWEN_DEVICE=auto            # auto | cpu | cuda
QWEN_MAX_NEW_TOKENS=512
QWEN_TEMPERATURE=0.7
QWEN_TOP_P=0.9
# Set to 1 to force the rule-based path without loading any model.
LLM_DISABLE=

# --- GRPO reward/eval endpoint (optional, when training the local policy) ---
# Point this at a local vLLM server of the SAME Qwen model (OpenAI-compatible).
REWARD_MODEL_URL=http://localhost:8000
REWARD_MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct

# --- Target / workflow ---
TARGET_PROFILE=financial_linux_web   # financial_linux_web | linux | containers | all
CTF_NAME=cowsay                      # CTF name from caibench/ctf_configs.jsonl (--live)

# --- Wazuh (real detection in --live mode; blank password = simulated proxy) ---
WAZUH_INDEXER_URL=https://localhost:9200
WAZUH_USER=admin
WAZUH_PASSWORD=
WAZUH_ALERTS_INDEX=wazuh-alerts-*
WAZUH_VERIFY_SSL=false
WAZUH_AGENT_NAME=                     # the target's Wazuh agent name
WAZUH_POLL_WAIT=3                     # seconds to wait for an alert to land before querying
